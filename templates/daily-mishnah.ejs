<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= englishTitle %></title>
    <% if (assets.hebrewFont) { %>
    <style>
      @font-face {
        font-family: "Guttman Hatzvi";
        src: url("<%= assets.hebrewFont %>");
        font-weight: 400;
        font-style: normal;
      }
    </style>
    <% } %>
    <style><%- css %></style>
    <style>
      @page {
        @top-left {
          content: none;
        }

        @top-center {
          content: none;
        }

        @top-right {
          background-color: transparent;
          background-image: url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%20100%2020%27%20preserveAspectRatio=%27none%27%3E%3Crect%20width=%27100%27%20height=%2720%27%20rx=%272%27%20ry=%272%27%20fill=%27%23344d6b%27/%3E%3C/svg%3E");
          background-position: top right;
          background-repeat: no-repeat;
          background-size: 100% 8mm;
          box-sizing: content-box;
          border: 0;
          border-radius: 1mm;
          box-shadow: none;
          color: #f4f8fc;
          content: <%- continuationHeaderTitleCss %>;
          direction: rtl;
          font-family: "Guttman Hatzvi", "Noto Serif Hebrew", "Noto Sans Hebrew", "Times New Roman", "Inter", "Segoe UI", Arial, serif;
          font-size: 9px;
          font-weight: 700;
          height: 8mm;
          line-height: 8mm;
          overflow: hidden;
          padding: 0 5mm 6mm;
          text-align: right;
          text-decoration: none;
          text-overflow: ellipsis;
          vertical-align: middle;
          white-space: nowrap;
          width: 164mm;
        }
      }

      @page:first {
        @top-left {
          content: none;
        }

        @top-center {
          content: none;
        }

        @top-right {
          content: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="pdf-page">
      <header class="document-header">
        <div class="header-main" dir="ltr">
          <div class="brand-row">
            <% if (assets.brandLogo) { %>
            <img class="brand-logo" src="<%= assets.brandLogo %>" alt="Time4Mishna">
            <% } else { %>
            <div class="text-logo">Time4Mishna</div>
            <% } %>
          </div>

          <div class="title-block" dir="rtl">
            <h1><%= hebrewTitle %></h1>
            <p class="subtitle" dir="ltr"><%= englishTitle %></p>
          </div>
        </div>

        <% if (dateInfo) { %>
        <%
          const dateParts = [
            dateInfo.hebrewDate ? { text: dateInfo.hebrewDate, dir: 'rtl' } : null,
            dateInfo.dayOfWeek ? { text: dateInfo.dayOfWeek, dir: 'ltr' } : null,
            dateInfo.gregorianDate ? { text: dateInfo.gregorianDate, dir: 'ltr' } : null,
            dateInfo.specialDate ? { text: dateInfo.specialDate, dir: 'rtl' } : null
          ].filter(Boolean);
        %>
        <div class="date-line" dir="ltr">
          <% dateParts.forEach((part, index) => { %>
            <% if (index > 0) { %><span class="date-separator" aria-hidden="true">·</span><% } %>
            <span dir="<%= part.dir %>"><%= part.text %></span>
          <% }) %>
        </div>
        <% if (dateInfo.additionalNotice) { %>
        <p class="notice"><%= dateInfo.additionalNotice %></p>
        <% } %>
        <% } %>
      </header>

      <section class="mishnayos">
        <% mishnayos.forEach((item) => { %>
        <article class="mishna-block">
          <h2>פרק <%= item.perek_he %> – משנה <%= item.mishna_he %></h2>
          <div class="mishna-text"><%= item.mishna_text %></div>
        </article>
        <% }) %>
      </section>

      <footer class="document-footer" dir="ltr">
        <% if (assets.jewishFuturesLogo) { %>
        <img class="jewish-futures-logo" src="<%= assets.jewishFuturesLogo %>" alt="Jewish Futures">
        <% } %>
        <span>Time4Torah is a member of the Jewish Futures family of organisations</span>
      </footer>
    </main>
  </body>
</html>
